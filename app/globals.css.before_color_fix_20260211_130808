@tailwind base;
@tailwind components;
@tailwind utilities;

/* Global theme tokens */
:root {
  --bg0: 8 10 14;
  --bg1: 12 16 24;

  --accent: 255 90 31;   /* ember */
  --accent2: 0 229 255;  /* neon blue */

  --text: 245 247 255;
  --muted: 170 176 190;
  --border: 255 255 255;

  --radius-xl: 24px;
  --radius-pill: 9999px;
}

html, body { min-height: 100%; }

body {
  background:
    radial-gradient(900px 600px at 15% 10%, rgba(var(--accent2), 0.16), transparent 60%),
    radial-gradient(800px 520px at 85% 0%, rgba(var(--accent), 0.14), transparent 55%),
    linear-gradient(180deg, rgb(var(--bg0)) 0%, rgb(var(--bg1)) 45%, rgb(var(--bg0)) 100%);
  color: rgb(var(--text));
}

/* Utility-ish classes (pure CSS) */
.bg-surface { background: rgba(15, 18, 26, 0.72); backdrop-filter: blur(10px); }
.bg-surface-strong { background: rgba(10, 12, 18, 0.82); backdrop-filter: blur(12px); }

.border-soft { border: 1px solid rgba(var(--border), 0.10); }
.shadow-soft { box-shadow: 0 20px 60px rgba(0,0,0,0.55); }

.glow-accent { box-shadow: 0 0 0 1px rgba(var(--accent2), 0.12), 0 0 30px rgba(var(--accent2), 0.10); }
.glow-accent:hover { box-shadow: 0 0 0 1px rgba(var(--accent2), 0.22), 0 0 40px rgba(var(--accent2), 0.16); }

/* Primary button used by SiteNav replacements */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  padding: 0.5rem 1.25rem;
  font-size: 0.75rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #ffffff;
  background: rgb(220 38 38); /* tailwind red-600 */
  transition: transform .15s ease, background-color .15s ease, box-shadow .15s ease;
}

.btn-primary:hover {
  background: rgb(239 68 68); /* tailwind red-500 */
  transform: translateY(-1px);
}

.btn-primary:active { transform: scale(0.98); }
