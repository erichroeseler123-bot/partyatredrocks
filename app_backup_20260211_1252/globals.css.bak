@tailwind base;
@tailwind components;
@tailwind utilities;

/* ────────────────────────────────────────────────
   Brand + dark system variables
───────────────────────────────────────────────── */
:root {
  --accent: 255 90 31;      /* ember */
  --accent2: 64 170 255;    /* electric blue */

  --bg0: 7 9 12;
  --bg1: 12 14 18;
  --bg2: 18 21 28;

  --text: 245 247 255;
  --muted: 170 176 190;
  --border: 255 255 255;

  --radius-xl: 24px;
  --radius-pill: 9999px;
}

/* ────────────────────────────────────────────────
   Base page background (kills flat void)
───────────────────────────────────────────────── */
html, body {
  min-height: 100%;
}

body {
  background:
    radial-gradient(900px 600px at 15% 10%, rgba(var(--accent2), 0.16), transparent 60%),
    radial-gradient(800px 520px at 85% 0%, rgba(var(--accent), 0.14), transparent 55%),
    linear-gradient(180deg, rgb(var(--bg0)) 0%, rgb(var(--bg1)) 45%, rgb(var(--bg0)) 100%);
  color: rgb(var(--text));
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ────────────────────────────────────────────────
   Lightweight utility classes (pure CSS, safe)
───────────────────────────────────────────────── */
.bg-surface {
  background: rgba(var(--bg2), 0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.bg-surface-strong {
  background: rgba(var(--bg2), 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.text-muted {
  color: rgba(var(--muted), 0.95);
}

.border-soft {
  border: 1px solid rgba(var(--border), 0.08);
}

.shadow-soft {
  box-shadow: 0 18px 50px rgba(0,0,0,0.45);
}

.glow-accent {
  box-shadow:
    0 0 0 1px rgba(var(--accent), 0.18),
    0 18px 60px rgba(var(--accent), 0.10);
}

.glow-accent2 {
  box-shadow:
    0 0 0 1px rgba(var(--accent2), 0.20),
    0 18px 60px rgba(var(--accent2), 0.10);
}

/* Hide scrollbar for horizontal tab bars */
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

/* ────────────────────────────────────────────────
   “Component” classes (pure CSS to avoid @apply issues)
───────────────────────────────────────────────── */
.section-pro {
  max-width: 72rem; /* ~max-w-6xl */
  margin-left: auto;
  margin-right: auto;
  padding-left: 1.5rem; /* px-6 */
  padding-right: 1.5rem;
  padding-top: 4rem;   /* py-16 */
  padding-bottom: 4rem;
}

@media (min-width: 768px) {
  .section-pro {
    padding-top: 5rem; /* md:py-20 */
    padding-bottom: 5rem;
  }
}

.card-pro {
  background: rgba(var(--bg2), 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(var(--border), 0.08);
  border-radius: calc(var(--radius-xl) + 8px);
  padding: 1.5rem;
  box-shadow: 0 18px 50px rgba(0,0,0,0.45);
  overflow: hidden;
  transition: transform 180ms ease, box-shadow 220ms ease, border-color 220ms ease;
}

@media (min-width: 768px) {
  .card-pro { padding: 2rem; }
}

.card-pro:hover {
  transform: translateY(-3px);
  box-shadow: 0 26px 70px rgba(0,0,0,0.55);
  border-color: rgba(var(--border), 0.12);
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  background: rgb(220 38 38); /* red-600 */
  color: #fff;

  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.06em;

  padding: 1rem 2rem; /* px-8 py-4 */
  border-radius: var(--radius-pill);

  box-shadow: 0 18px 35px rgba(220, 38, 38, 0.22);
  transition: transform 160ms ease, box-shadow 200ms ease, background 200ms ease, opacity 200ms ease;
}

.btn-primary:hover {
  background: rgb(239 68 68); /* red-500 */
  box-shadow: 0 22px 45px rgba(239, 68, 68, 0.26);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px rgba(248, 113, 113, 0.55),
    0 0 0 6px rgba(0,0,0,0.85),
    0 22px 45px rgba(239, 68, 68, 0.26);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  background: rgba(0,0,0,0.10);
  color: #fff;

  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;

  padding: 0.75rem 1.5rem;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(161, 161, 170, 0.55); /* zinc-ish */

  transition: transform 160ms ease, border-color 200ms ease, background 200ms ease, opacity 200ms ease;
}

.btn-secondary:hover {
  background: rgba(255,255,255,0.06);
  border-color: rgba(228, 228, 231, 0.70);
  transform: translateY(-1px);
}

.btn-secondary:active { transform: scale(0.98); }

.btn-secondary:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px rgba(161, 161, 170, 0.55),
    0 0 0 6px rgba(0,0,0,0.85);
}

.btn-disabled,
.btn-primary:disabled,
.btn-secondary:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none !important;
}

/* ────────────────────────────────────────────────
   Prose defaults (optional, safe)
───────────────────────────────────────────────── */
.prose {
  max-width: none;
  color: rgb(212 212 216); /* zinc-300 */
  font-size: 1rem;
  line-height: 1.75;
}

@media (min-width: 768px) {
  .prose { font-size: 1.125rem; }
}

.prose h1, .prose h2, .prose h3 {
  color: #fff;
  font-weight: 900;
  letter-spacing: -0.02em;
}

.prose a {
  color: rgb(248 113 113); /* red-400 */
  text-decoration: underline;
  text-underline-offset: 3px;
}

.prose a:hover { color: rgb(252 165 165); } /* red-300 */
