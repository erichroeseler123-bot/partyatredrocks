function toneBadge(tone: Card["tone"]) {
  const base =
    "inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.22em]";
  switch (tone) {
    case "shared":
      return <span className={`${base} border-zinc-600/60 bg-surface/40 text-zinc-200`}>Shared ride</span>;
    case "suv":
      return <span className={`${base} border-red-500/30 bg-red-500/10 text-red-200`}>Private vehicle</span>;
    case "sprinter":
      return <span className={`${base} border-cyan-500/30 bg-cyan-500/10 text-cyan-100`}>Group vehicle</span>;
    case "bus":
      return <span className={`${base} border-violet-500/30 bg-violet-500/10 text-violet-100`}>Large group</span>;
    default:
      return <span className={`${base} border-zinc-600/60 bg-surface/40 text-zinc-200`}>Other</span>;
  }
}

