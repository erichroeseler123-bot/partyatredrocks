function TonePill({ tone }: { tone: Card["tone"] }) {
  const cls =
    tone === "shared"
      ? "border-red-400/20 bg-red-500/10 text-red-200"
      : tone === "private"
      ? "border-cyan-400/20 bg-cyan-500/10 text-cyan-100"
      : tone === "sprinter"
      ? "border-violet-400/20 bg-violet-500/10 text-violet-100"
      : tone === "bus"
      ? "border-emerald-400/20 bg-emerald-500/10 text-emerald-100"
      : "border-white/15 bg-white/5 text-zinc-200";

  return (
    <span className={`inline-flex items-center gap-2 rounded-full border px-3 py-1 text-[10px] font-black uppercase tracking-[0.28em] ${cls}`}>
      <span className="h-1.5 w-1.5 rounded-full bg-current opacity-80" />
      {tone === "shared"
        ? "Shared ride"
        : tone === "private"
        ? "Private"
        : tone === "sprinter"
        ? "Sprinter"
        : tone === "bus"
        ? "Bus"
        : "Other"}
    </span>
  );
}

